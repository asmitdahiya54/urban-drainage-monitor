# Copy this file to .env and fill in values. Never commit .env.

# --- Flask backend ---
FLASK_APP=backend.app:app
# Debug is OFF unless set to exactly 1. Never set 1 in production.
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-this-in-development
# Max request body in bytes (default 1 MB)
# MAX_CONTENT_LENGTH=1048576
# Include verbose diagnostics (exact PostGIS version) in /api/health. Keep 0 in production.
# EXPOSE_SERVER_DETAILS=0
# Comma-separated origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database (PostgreSQL + PostGIS) ---
# Replace YOUR_PASSWORD with your local postgres password. Never commit real credentials.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/urban_drainage_db
# Optional: separate throwaway database used by `pytest` (its tables are dropped)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/urban_drainage_test_db

# --- Authentication (JWT) ---
# Used to sign access tokens. Falls back to SECRET_KEY if unset.
JWT_SECRET_KEY=change-this-jwt-secret-in-development
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_MINUTES=120

# --- Civic / environmental data (Step 10) ---
# Leave unset to use the clearly labelled MOCK provider (demo data, not official).
# Set a base URL to plug in a real, verified public API instead. Never commit keys.
# CIVIC_API_BASE_URL=https://example-official-api.gov/api
# CIVIC_API_KEY=your-api-key
# CIVIC_API_KEY_HEADER=X-API-Key
# CIVIC_API_SOURCE_NAME=Official source name
# CIVIC_API_SOURCE_URL=https://example-official-api.gov
# CIVIC_API_TIMEOUT_SECONDS=8
# CIVIC_CACHE_TTL_SECONDS=300

# --- Frontend (Vite) ---
# Same-origin path works locally and in Lovable Preview. Vite forwards it to Flask.
VITE_API_URL=/api
# Google Maps JavaScript API browser key (Maps page basemap). Browser-restricted
# key only — never a server key, and never commit a real .env file.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Production (Render + Supabase) — set these in the Render dashboard, NOT in Git ---
# DATABASE_URL: Supabase → Project Settings → Database → Connection string →
#   "Session pooler" (IPv4-friendly). Format (never commit the real password):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SECRET_KEY / JWT_SECRET_KEY: two DIFFERENT long random values (Render can generate them).
# CORS_ORIGINS=https://flowfinder-community.lovable.app
# FLASK_APP=backend.app
# FLASK_DEBUG=0
# JWT_ACCESS_TOKEN_MINUTES=120
# PORT is supplied by Render; gunicorn binds 0.0.0.0:$PORT.
#
# Frontend → Render: the published site proxies /api/* server-side. Point it at
# the deployed API with BACKEND_URL (or src/config/backend.ts):
# BACKEND_URL=https://<your-render-service>.onrender.com

# Google sign-in (optional). Same OAuth Web client ID in both places.
# Frontend (public, browser-safe):
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Backend (Flask verifies the Google ID token audience against this):
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
